<div class="container">
  <div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-4">
      <div class="login-card text-center">
        <h3 class="mb-4">Login</h3>

        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-3">
            <%= f.label :email, class: 'form-label text-white' %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>

          <div class="mb-3">
            <%= f.label :password, class: 'form-label text-white' %>
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
          </div>

          <div class="d-grid gap-2">
            <%= f.submit "Sign in", class: "btn btn-primary" %>
          </div>
        <% end %>

        <div class="mt-3">
          <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-white" %>
        </div>
        
        <hr class="text-white my-4">


        <p class="mt-4">
          Don’t have an account yet?
          <%= link_to "Register for free", new_registration_path(resource_name), class: "text-white" %>
        </p>
      </div>
    </div>
  </div>
</div>