<div class="container my-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3">Doctor's Dashboard</h1>
    
    <!-- Logout Button -->
    <%= link_to "Logout", destroy_user_session_path, method: :delete, data: { turbo_method: :delete }, class: "btn btn-danger" %>

  </div>

  <!-- Registered Patients Table -->
  <div class="card mb-4">
    <div class="card-header">
      <h5 class="mb-0">Registered Patients</h5>
    </div>
    <div class="card-body p-0">
      <table class="table table-hover">
        <thead class="table-light">
          <tr>
            <th>Name</th>
            <th>Age</th>
            <th>Gender</th>
            <th>Phone</th>
            <th>Address</th>
          </tr>
        </thead>
        <tbody>
          <% @patients.each do |patient| %>
            <tr>
              <td><%= patient.name %></td>
              <td><%= patient.age %></td>
              <td><%= patient.gender %></td>
              <td><%= patient.phone %></td>
              <td><%= patient.address %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Patients Registration Graph -->
  <div class="card">
    <div class="card-header">
      <h5 class="mb-0">Patient Registrations Over Time</h5>
    </div>
    <div class="card-body">
      <%= line_chart @patients_by_day, height: "300px", library: { backgroundColor: "transparent" } %>
    </div>
  </div>
</div>